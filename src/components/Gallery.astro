---
interface Props {
    images: string[];
    interval?: number;
}

const { images, interval = 5000 } = Astro.props;
---

<div class="gallery" data-interval={interval}>
    {
        images.map((src, index) => (
            <img
                src={src}
                alt={`Gallery image ${index + 1}`}
                class="gallery-image"
                class:list={[{ active: index === 0 }]}
            />
        ))
    }
</div>

<style is:global>
    html,
    body {
        margin: 0;
        background: transparent;
    }
</style>

<style>
    .gallery {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        background: transparent;
    }

    .gallery-image {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
        opacity: 0;
        transition: opacity 1.5s ease-in-out;
    }

    .gallery-image.active {
        opacity: 1;
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>(".gallery").forEach((gallery) => {
        const images = gallery.querySelectorAll(".gallery-image");
        const interval = Number(gallery.dataset.interval) || 5000;
        let currentIndex = 0;

        if (images.length > 1) {
            setInterval(() => {
                images[currentIndex].classList.remove("active");
                currentIndex = (currentIndex + 1) % images.length;
                images[currentIndex].classList.add("active");
            }, interval);
        }
    });
</script>
