---
import Layout from "../layouts/Layout.astro";

const images = [
	"https://images.squarespace-cdn.com/content/607639d86d7e2d6b1c5ed9df/febaca2d-6c15-4d7d-b665-61c70a11b5c9/488A0091.jpg",
	"https://images.squarespace-cdn.com/content/607639d86d7e2d6b1c5ed9df/b28de16f-21a9-4041-9dab-47ac2dcb77d5/488A0001.jpg",
	"https://images.squarespace-cdn.com/content/607639d86d7e2d6b1c5ed9df/fe1840d5-c4bc-4fd9-bfa1-8fd89075eeb0/488A0022.jpg",
	"https://images.squarespace-cdn.com/content/607639d86d7e2d6b1c5ed9df/e9185d95-94b6-468e-8e9a-b822aa71cc20/IMG_4563.jpg",
];
---

<Layout title="Gallery 1">
	<div class="gallery">
		{
			images.map((src, index) => (
				<img
					src={src}
					alt={`Gallery image ${index + 1}`}
					class="gallery-image"
					class:list={[{ active: index === 0 }]}
				/>
			))
		}
	</div>
</Layout>

<style>
	.gallery {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		overflow: hidden;
		background: black;
	}

	.gallery-image {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		opacity: 0;
		transition: opacity 1.5s ease-in-out;
	}

	.gallery-image.active {
		opacity: 1;
	}
</style>

<script>
	const images = document.querySelectorAll(".gallery-image");
	let currentIndex = 0;

	if (images.length > 1) {
		setInterval(() => {
			images[currentIndex].classList.remove("active");
			currentIndex = (currentIndex + 1) % images.length;
			images[currentIndex].classList.add("active");
		}, 5000);
	}
</script>
